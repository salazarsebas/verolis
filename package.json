{
  "name": "verolis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web",
    "dev:web": "next dev apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build apps/web --webpack",
    "build:api": "npm run build --prefix apps/api",
    "start": "next start apps/web",
    "lint": "eslint apps/web apps/api",
    "test": "vitest --config apps/web/vitest.config.ts --run && npm run test:run --prefix apps/api",
    "test:web": "vitest --config apps/web/vitest.config.ts --run",
    "test:api": "npm run test:run --prefix apps/api",
    "test:ui": "vitest --config apps/web/vitest.config.ts --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.6.1",
    "@x402/core": "^2.6.0",
    "@x402/express": "^2.6.0",
    "@x402/fetch": "^2.6.0",
    "@x402/next": "^2.6.0",
    "@x402/stellar": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
